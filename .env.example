# /call-me for herdr -- optional settings.
#
# Copy this to the plugin's config dir and edit:
#   cp .env.example "$(herdr plugin config-dir radres.call-me)/.env"
#
# Every line here is optional. The defaults are what most people want.

# Your /call-me number, 10 digits, from the /call-me app's My Number tab.
# Usually you do NOT need this: the `pair` pane writes it to ~/.aiphone/config.json,
# which every /call-me integration reads. Set it here only to override that.
#CALLME_NUMBER=

# What a blocked agent is worth: call | text | off
CALLME_ON_BLOCKED=call

# What a finished agent is worth: text | call | off
CALLME_ON_DONE=text

# Type the answer you speak into the blocked agent. This is the point of the
# plugin; set to 0 if you would rather just be told what you said.
CALLME_ANSWER_BACK=1

# Seconds to wait before ringing, so a human sitting at the keyboard wins.
# The agent is re-checked after the delay and the call is dropped if it moved on.
CALLME_GRACE_S=20

# How long the phone rings and stays connected, 30-300.
CALLME_CALL_TIMEOUT_S=120

# Minimum seconds between alerts for the same pane in the same state.
CALLME_COOLDOWN_S=300

# Terminal lines read off the pane to work out what the agent is asking.
CALLME_READ_LINES=40

# Local herdr toasts alongside the phone. Set to 0 for silence on screen.
CALLME_TOAST=1

# Master switch. The toggle action writes a state file that overrides this.
CALLME_ENABLED=1

# Thread name on the phone. Defaults to "herdr · <agent> · <workspace>", which
# gives each project its own conversation.
#CALLME_LABEL=
